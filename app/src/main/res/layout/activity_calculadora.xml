<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fondo_calc"
        android:scaleType="centerCrop"
        android:contentDescription="@string/titulo_app"
        />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/titulo_app"
                android:textColor="@color/titulo_texto"
                android:background="@color/titulo_fondo"
                android:textSize="@dimen/tamano_titulo"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="12dp"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/autor"
                android:textColor="@color/titulo_texto"
                android:layout_marginTop="8dp"
                />

            <EditText
                android:id="@+id/etLitros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_litros"
                android:inputType="numberDecimal"
                android:background="@color/resultado_fondo"
                android:layout_marginTop="12dp"
                />

            <EditText
                android:id="@+id/etPrecioHabitual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_precio_habitual"
                android:inputType="numberDecimal"
                android:background="@color/resultado_fondo"
                android:layout_marginTop="8dp"
                />

            <EditText
                android:id="@+id/etPrecioBarata"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_precio_barata"
                android:inputType="numberDecimal"
                android:background="@color/resultado_fondo"
                android:layout_marginTop="8dp"
                />

            <EditText
                android:id="@+id/etKm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_km"
                android:inputType="numberDecimal"
                android:background="@color/resultado_fondo"
                android:layout_marginTop="8dp"
                />

            <EditText
                android:id="@+id/etConsumo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_consumo"
                android:inputType="numberDecimal"
                android:background="@color/resultado_fondo"
                android:layout_marginTop="8dp"
                />

            <Button
                android:id="@+id/btnCalcular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/boton_calcular"
                android:layout_marginTop="12dp"
                />

            <TextView
                android:id="@+id/tvResultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/resultado_vacio"
                android:textSize="@dimen/tamano_texto"
                android:textColor="@color/texto"
                android:background="@color/resultado_fondo"
                android:padding="12dp"
                android:layout_marginTop="12dp"
                />

            <Button
                android:id="@+id/btnVolver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/boton_volver"
                android:layout_marginTop="12dp"
                />
        </LinearLayout>
    </ScrollView>
</FrameLayout>